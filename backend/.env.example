# Copy this file to .env and fill in real values. Never commit .env itself.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_system
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-string
JWT_ISSUER=pos-system
JWT_ACCESS_TOKEN_TTL=36000

# Comma-separated list of allowed frontend origins for CORS
APP_CORS_ORIGINS=http://localhost:5173

APP_ENV=local
APP_DEBUG=true

# ---------------------------------------------------------------------
# GST E-Invoice / E-Way Bill (section 10) — OFF (GST_API_ENABLED=false)
# until a real GSP (GST Suvidha Provider) account exists. With it off,
# every Generate E-Invoice / E-Way Bill request returns a clear
# "not configured" error instead of pretending to succeed. Fill these in
# only once you have real credentials from your chosen GSP — this app does
# not select or hardcode a specific provider.
# ---------------------------------------------------------------------
GST_API_ENABLED=false
# sandbox | production — never point at production without verified sandbox testing first.
GST_API_ENV=sandbox
# Free-text identifier for whichever GSP you contract with (e.g. "cleartax", "cygnet", "masters-india").
GST_API_PROVIDER=
GST_API_BASE_URL=
GST_API_USERNAME=
GST_API_PASSWORD=
GST_API_CLIENT_ID=
GST_API_CLIENT_SECRET=
# Your own (seller/business) GSTIN, sent as SellerDtls.Gstin on every e-invoice/e-way bill request.
GST_API_SELLER_GSTIN=
